{
  "name": "sonata-desktop",
  "version": "1.8.3",
  "description": "7-Sonata — десктопный музыкальный плеер (встроенный сервер, работает без браузера)",
  "author": {
    "name": "wmisha2010"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "stage": "node scripts/stage.mjs",
    "start": "electron .",
    "dist": "npm run stage && electron-builder",
    "dist:win": "npm run stage && electron-builder --win",
    "dist:linux": "npm run stage && electron-builder --linux",
    "dist:mac": "npm run stage && electron-builder --mac"
  },
  "build": {
    "appId": "com.zai.sonata",
    "productName": "7-Sonata",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "afterPack": "scripts/afterpack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "7-Sonata",
      "deleteAppDataOnUninstall": false,
      "artifactName": "7-Sonata-${version}-Setup.exe"
    },
    "portable": {
      "artifactName": "7-Sonata-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.12"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
