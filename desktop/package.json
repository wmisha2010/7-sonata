{
  "name": "sonata-desktop",
  "version": "1.7.1",
  "description": "7-Sonata — десктопный музыкальный плеер",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c green,blue \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:headless": "concurrently -k -n VITE,ELECTRON -c green,blue \"vite\" \"wait-on tcp:5173 && xvfb-run -a -s '-screen 0 1280x800x24' electron . --no-sandbox\"",
    "build:renderer": "vite build",
    "start": "electron . --no-sandbox",
    "start:headless": "xvfb-run -a -s '-screen 0 1280x800x24' electron . --no-sandbox",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.zai.sonata",
    "productName": "7-Sonata",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "extra",
        "to": "."
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.png",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false,
      "forceCodeSigning": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "7-Sonata",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio"
    }
  },
  "dependencies": {
    "@jofr/capacitor-media-session": "^4.0.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "music-metadata": "^12.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "hls.js": "^1.7.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
